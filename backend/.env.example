# Example environment variables for ExamGenius (Gemini Edition)

# Google AI Studio (Gemini)
AI_STUDIO_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent
AI_STUDIO_KEY=your_google_ai_studio_api_key_here

# Optional: Vector Database Configuration
MILVUS_HOST=localhost
MILVUS_PORT=19530

# FastAPI Server Port (Cloud Run will auto-assign this)
PORT=8080
